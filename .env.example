# Fuatilia stack configuration — the environment contract (issues #75 + #138).
#
#   cp .env.example .env      # then set the CHANGE_ME values before first up
#
# docker compose auto-loads this file for ${...} interpolation in
# docker-compose.yml. scripts/validate_deploy.py enforces the contract
# mechanically in BOTH directions: every env var referenced by the compose
# file, read from Go code (backend-go/), read by the migration runner
# (db/*.cjs), or read by the web console (frontend/src — process.env.*) MUST
# have a key here, so the contract cannot rot silently. DATABASE_URL must
# agree with POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
#
# NO default credentials are committed: every secret below is a CHANGE_ME
# placeholder. Generate real values with `openssl rand -hex 24` (24 bytes =
# 48 hex chars). .env is gitignored (.gitignore: ".env", ".env.*") — real
# secrets never get committed.

# --- PostgreSQL (truth store — ADR-0002) -----------------------------------
# Credentials the postgres container initializes itself with; DATABASE_URL
# must reference the same user/password/db.
POSTGRES_USER=fuatilia
POSTGRES_DB=fuatilia
# REQUIRED — no default. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME__RUN_openssl_rand_hex_24

# --- migrate job + db tooling: PostgreSQL wire variables --------------------
# Read by db/migrate.cjs (the one-shot schema job) and db/exec.cjs /
# db/smoke.cjs. Inside the compose stack the migrate service gets these set
# FOR it (docker-compose.yml: PGHOST=postgres, trust-auth user above); the
# keys exist here for local runs against a dev cluster (e.g. the 16.4 lane
# cluster on 127.0.0.1:5435). The runner speaks TRUST auth only — no
# PGPASSWORD, by design ("SASL/md5 refused loudly"): see db/README.md.
PGHOST=127.0.0.1
PGPORT=5435
PGUSER=postgres
PGDATABASE=fuatilia_dev

# --- api + worker: PostgreSQL connection string -----------------------------
# Compose-internal service DNS name is "postgres". sslmode=disable applies to
# the private compose network only (trust-auth rationale and the TLS story:
# docs/DEPLOY.md). The password must equal POSTGRES_PASSWORD above.
DATABASE_URL=postgres://fuatilia:CHANGE_ME__RUN_openssl_rand_hex_24@postgres:5432/fuatilia?sslmode=disable

# --- api: listener + connection-pool contract -------------------------------
# The compose port mapping "8080:8080" and the api image's HEALTHCHECK
# (http://127.0.0.1:8080/v1/health) assume this default — if you change the
# port, change the mapping and the probe with it (docs/DEPLOY.md).
LISTEN_ADDR=0.0.0.0:8080
# pgxpool knobs read by backend-go/internal/infra/config.go (LoadConfig):
#   MAX_CONNS  — pool capacity (pgxpool.Config.MaxConns)
#   LIFETIME   — recycle age of a connection (Go duration, min 1s)
#   IDLE_TIME  — idle eviction age (Go duration, min 1s)
FUATILIA_PG_MAX_CONNS=10
FUATILIA_PG_LIFETIME=30m
FUATILIA_PG_IDLE_TIME=5m

# --- worker: NATS fabric (ADR-0003) + outbox relay tuning -------------------
# JetStream endpoint inside the compose network.
NATS_URL=nats://nats:4222
# Events claimed per poll (integer ≥ 1).
OUTBOX_BATCH=100
# Sleep between polls when the outbox is empty (Go duration: 100ms, 1s, 2s…).
OUTBOX_POLL_INTERVAL=1s
# Delivery attempts per event before it is parked for inspection (integer ≥ 1).
# At-least-once end-to-end: consumers stay idempotent regardless of this cap.
OUTBOX_MAX_ATTEMPTS=5

# --- Daraja (M-Pesa) STK execution client (backend-go/internal/daraja) ------
# Read by daraja.ConfigFromEnv. The consumer key/secret pair is REQUIRED by
# that constructor — placeholders here; obtain real values from the Safaricom
# Daraja portal, never commit them. Base URL defaults to the Safaricom
# sandbox when empty; set a production URL only for production deployments.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=CHANGE_ME__DARAJA_CONSUMER_KEY
DARAJA_CONSUMER_SECRET=CHANGE_ME__DARAJA_CONSUMER_SECRET

# --- frontend: web console (issue #138) -------------------------------------
# SERVER-side, runtime: the target the BFF route handlers (app/api/v1/*,
# app/(portal)/api/*) relay browser calls to. docker-compose.yml pins it to
# the compose-internal api service; this key documents that contract.
API_BASE_URL=http://api:8080
# BROWSER-side, BUILD-TIME (inlined by `next build` into the client bundle —
# a runtime .env value has NO effect on it). Unset/empty (the default) keeps
# the browser on the same-origin BFF path (/api/v1) so the session token
# never enters browser JS — the compose stack's intended mode. Only set this
# (and rebuild the frontend image) for a direct browser→API deployment:
#   NEXT_PUBLIC_API_BASE=http://api.example.com:8080
NEXT_PUBLIC_API_BASE=

# --- test harness (make gate — never read by a running stack) ---------------
# The Go suites (backend-go) and the TS PG-adapter specs (src/) refuse to run
# against an unreachable cluster (no silent skips). Placeholders only — the
# Makefile supplies its own defaults, overridable:
#   make gate FUATILIA_TEST_PGBIN=/path/to/pg-16-bin FUATILIA_TEST_DATABASE_URL=postgres://…
FUATILIA_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5435/fuatilia_pgadapters_test
FUATILIA_TEST_PGBIN=/home/z/tools/pg164/bin
# Also read (pgtest/testutil overrides, rarely set): FUATILIA_TEST_PGPORT,
# FUATILIA_TEST_PGDATA. NODE_ENV is managed by Next/the Dockerfile, never by
# .env.
