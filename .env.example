# Fuatilia stack configuration — the environment contract (issue #75).
#
#   cp .env.example .env      # then set the CHANGE_ME values before first up
#
# docker compose auto-loads this file for ${...} interpolation in
# docker-compose.yml. scripts/validate_deploy.py enforces the contract in one
# direction, mechanically: every env var referenced by the compose file or
# read from Go code (os.Getenv / os.LookupEnv in backend-go/) MUST have a key
# here, so the contract cannot rot silently. DATABASE_URL must agree with
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
#
# NO default credentials are committed: every secret below is a CHANGE_ME
# placeholder. Generate real values with `openssl rand -hex 24` (24 bytes =
# 48 hex chars). .env is gitignored (.gitignore: ".env", ".env.*" with an
# explicit "!.env.example" exception) — real secrets never get committed.

# --- PostgreSQL (truth store — ADR-0002) -----------------------------------
# Credentials the postgres container initializes itself with; DATABASE_URL
# must reference the same user/password/db.
POSTGRES_USER=fuatilia
POSTGRES_DB=fuatilia
# REQUIRED — no default. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME__RUN_openssl_rand_hex_24

# --- api + worker: PostgreSQL connection string -----------------------------
# Compose-internal service DNS name is "postgres". sslmode=disable applies to
# the private compose network only (trust-auth rationale and the TLS story:
# docs/DEPLOY.md). The password must equal POSTGRES_PASSWORD above.
DATABASE_URL=postgres://fuatilia:CHANGE_ME__RUN_openssl_rand_hex_24@postgres:5432/fuatilia?sslmode=disable

# --- api: listener + connection-pool contract -------------------------------
# The compose port mapping "8080:8080" and the api image's HEALTHCHECK
# (http://127.0.0.1:8080/v1/health) assume this default — if you change the
# port, change the mapping and the probe with it (docs/DEPLOY.md).
LISTEN_ADDR=0.0.0.0:8080
# pgxpool knobs for the persistence adapters (issues #72/#73 read these):
#   MAX_CONNS          — pool capacity (pgxpool.Config.MaxConns)
#   MAX_CONN_LIFETIME  — recycle age of a connection (Go duration)
#   MAX_CONN_IDLE_TIME — idle eviction age (Go duration)
FUATILIA_PG_MAX_CONNS=10
FUATILIA_PG_MAX_CONN_LIFETIME=30m
FUATILIA_PG_MAX_CONN_IDLE_TIME=5m

# --- api: rate limiting + security headers (issue #130) ---------------------
# Token-bucket limiter, one bucket per principal+IP (authed routes) or per
# client IP (public routes):
#   RATE_LIMIT_RPM   — per-key per-minute request budget; "0" DISABLES the
#                      limiter; unset → 300 (5/s sustained).
#   RATE_LIMIT_BURST — bucket capacity (the largest instant burst); unset →
#                      the RPM value.
# Refusals answer 429 with the contract error envelope and a Retry-After.
# The limiter is per-process (in-memory): scale the budget per replica or
# bind a shared store behind transport.RateLimitStore.
FUATILIA_RATE_LIMIT_RPM=300
FUATILIA_RATE_LIMIT_BURST=300
# Strict-Transport-Security: the kernel serves plain HTTP behind the
# deployment's TLS story (docs/DEPLOY.md) — enable HSTS only once TLS
# termination is real, or HTTP clients become hard-pinned to HTTPS.
#   HSTS_ENABLED — "1"/"true" adds Strict-Transport-Security to every
#                  response; unset/anything else keeps it off.
#   HSTS_MAX_AGE — policy max-age in seconds; unset → 31536000 (one year).
FUATILIA_HSTS_ENABLED=0
FUATILIA_HSTS_MAX_AGE=31536000

# --- worker: NATS fabric (ADR-0003) + outbox relay tuning -------------------
# JetStream endpoint inside the compose network.
NATS_URL=nats://nats:4222
# Events claimed per poll (integer ≥ 1).
OUTBOX_BATCH=100
# Sleep between polls when the outbox is empty (Go duration: 100ms, 1s, 2s…).
OUTBOX_POLL_INTERVAL=1s
# Delivery attempts per event before it is parked for inspection (integer ≥ 1).
# At-least-once end-to-end: consumers stay idempotent regardless of this cap.
OUTBOX_MAX_ATTEMPTS=5
